   "source": [
    "# ============================================\n",
    "# TIME SERIES ANALYSIS AND ARIMA FORECASTING\n",
    "# PIMA DIABETES DATASET\n",
    "# ============================================\n",
    "\n",
    "# Import Libraries\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "from statsmodels.tsa.seasonal import seasonal_decompose\n",
    "from statsmodels.tsa.arima.model import ARIMA\n",
    "\n",
    "\n",
    "# ============================================\n",
    "# 1. Load the Dataset\n",
    "# ============================================\n",
    "\n",
    "file_name = \"pima-indians-diabetes.data.txt\"\n",
    "\n",
    "columns = [\n",
    "    \"Pregnancies\",\n",
    "    \"Glucose\",\n",
    "    \"BloodPressure\",\n",
    "    \"SkinThickness\",\n",
    "    \"Insulin\",\n",
    "    \"BMI\",\n",
    "    \"DiabetesPedigreeFunction\",\n",
    "    \"Age\",\n",
    "    \"Outcome\"\n",
    "]\n",
    "\n",
    "diabetes_data = pd.read_csv(\n",
    "    file_name,\n",
    "    header=None,\n",
    "    names=columns\n",
    ")\n",
    "\n",
    "print(\"Dataset loaded successfully!\")\n",
    "\n",
    "\n",
    "# ============================================\n",
    "# 2. Check and Preview the Data\n",
    "# ============================================\n",
    "\n",
    "print(\"\\nFirst 5 rows of the dataset:\")\n",
    "display(diabetes_data.head())\n",
    "\n",
    "print(\"\\nDataset shape:\")\n",
    "print(diabetes_data.shape)\n",
    "\n",
    "\n",
    "# ============================================\n",
    "# 3. Select Glucose Data\n",
    "# ============================================\n",
    "\n",
    "glucose_data = diabetes_data[\"Glucose\"].copy()\n",
    "\n",
    "# Remove missing values\n",
    "glucose_data = glucose_data.dropna()\n",
    "\n",
    "print(\"\\nNumber of Glucose observations:\")\n",
    "print(len(glucose_data))\n",
    "\n",
    "\n",
    "# ============================================\n",
    "# 4. Plot Time Series Data\n",
    "# ============================================\n",
    "\n",
    "plt.figure(figsize=(12, 5))\n",
    "\n",
    "plt.plot(\n",
    "    glucose_data.values,\n",
    "    label=\"Glucose Level\"\n",
    ")\n",
    "\n",
    "plt.xlabel(\"Observation Index\")\n",
    "plt.ylabel(\"Glucose Level\")\n",
    "plt.title(\"Time Series of Glucose Levels\")\n",
    "plt.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================\n",
    "# 5. Decompose Time Series\n",
    "# ============================================\n",
    "\n",
    "# The Pima dataset is not a real time-series dataset.\n",
    "# Period=30 is used only for demonstration.\n",
    "\n",
    "decomposition = seasonal_decompose(\n",
    "    glucose_data,\n",
    "    model=\"additive\",\n",
    "    period=30\n",
    ")\n",
    "\n",
    "fig, axes = plt.subplots(\n",
    "    3,\n",
    "    1,\n",
    "    figsize=(12, 8)\n",
    ")\n",
    "\n",
    "decomposition.trend.plot(\n",
    "    ax=axes[0],\n",
    "    title=\"Trend Component\"\n",
    ")\n",
    "\n",
    "decomposition.seasonal.plot(\n",
    "    ax=axes[1],\n",
    "    title=\"Seasonal Component\"\n",
    ")\n",
    "\n",
    "decomposition.resid.plot(\n",
    "    ax=axes[2],\n",
    "    title=\"Residual Component\"\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================\n",
    "# 6. Apply Moving Average for Smoothing\n",
    "# ============================================\n",
    "\n",
    "diabetes_data[\"Glucose_MA\"] = (\n",
    "    diabetes_data[\"Glucose\"]\n",
    "    .rolling(window=7)\n",
    "    .mean()\n",
    ")\n",
    "\n",
    "plt.figure(figsize=(12, 5))\n",
    "\n",
    "plt.plot(\n",
    "    diabetes_data[\"Glucose\"],\n",
    "    label=\"Original\",\n",
    "    alpha=0.5\n",
    ")\n",
    "\n",
    "plt.plot(\n",
    "    diabetes_data[\"Glucose_MA\"],\n",
    "    label=\"7-Observation Moving Average\"\n",
    ")\n",
    "\n",
    "plt.xlabel(\"Observation Index\")\n",
    "plt.ylabel(\"Glucose Level\")\n",
    "plt.title(\"Moving Average Smoothing\")\n",
    "\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================\n",
    "# 7. Split Data into Training and Testing\n",
    "# ============================================\n",
    "\n",
    "train_size = int(len(glucose_data) * 0.8)\n",
    "\n",
    "train = glucose_data.iloc[:train_size]\n",
    "test = glucose_data.iloc[train_size:]\n",
    "\n",
    "print(\"\\nTraining data size:\", len(train))\n",
    "print(\"Testing data size:\", len(test))\n",
    "\n",
    "\n",
    "# ============================================\n",
    "# 8. Build ARIMA Model\n",
    "# ============================================\n",
    "\n",
    "# ARIMA(p,d,q)\n",
    "# p = 5\n",
    "# d = 1\n",
    "# q = 0\n",
    "\n",
    "model = ARIMA(\n",
